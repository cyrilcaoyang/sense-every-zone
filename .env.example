# Copy to .env (gitignored) and fill in values.
# All variables are optional — defaults are shown.

# Path to sensors.yaml (overrides the default ./sensors.yaml search)
# SEZ_SENSORS_PATH=/etc/sense_every_zone/sensors.yaml

# Log directory (overrides /var/log/sense_every_zone → ~/.sense_every_zone/logs)
# SEZ_LOG_DIR=/var/log/sense_every_zone

# Log level: DEBUG | INFO | WARNING | ERROR
# SEZ_LOG_LEVEL=INFO

# Server bind address and port
# SEZ_HOST=0.0.0.0
# SEZ_PORT=8030
